#
# Description
# -----------
# This table stores the categories for resources
#
# Fields
# ------
# id:                       The ID assigned to the record.
# uuid:                     The Universal Unique ID.
# tnid:                     The Tenant ID the record belongs to.
#
# section_id:               The ID of the section the category is in.
#
# name:                     The Name of the category.
# permalink:                The permalink of the category.
#
# flags:                    The options for the category.
#
#                               0x01 - 
#                               0x02 - 
#                               0x04 - 
#                               0x08 - 
#
# sequence:                 The order to display the category within the section.
#
# image_id:                 The image to use for the category.
# synopsis:                 The short description of the category.
# description:              The full description/intro for the category.
# customer_perms:           The list of customer permission tags (ciniki_customer_tags, type 30), double colon delimited, alphabetised
#
# date_added:               The UTC date and time the record was added.
# last_updated:             The UTC date and time the record was last update.
#
create table ciniki_reslib_categories (
    id int not null auto_increment,
    uuid char(36) not null,
    tnid int not null,

    section_id int not null,
    name varchar(250) not null,
    permalink varchar(250) not null,
    flags int not null,
    sequence int not null,
    image_id int not null,
    synopsis text not null,
    description text not null,
    customer_perms varchar(1000) not null,

    date_added datetime not null,
    last_updated datetime not null,
    primary key (id),
    unique index (uuid),
    unique index (section_id, permalink),
    index (section_id, name),
    index sync (tnid, uuid, last_updated)
) ENGINE='InnoDB', COMMENT='v1.01';
